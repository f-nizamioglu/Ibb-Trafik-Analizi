# ─── Database ───
DB_HOST=localhost
DB_PORT=5433
DB_NAME=istanbul_traffic
DB_USER=postgres
DB_PASSWORD=your_password_here

# ─── App ───
APP_ENV=development
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# ─── PostGIS ST_ClusterDBSCAN Parameters ───
# Geometry is stored in EPSG:32636 (metric), so eps is in metres.
DBSCAN_EPS_METERS=500.0
DBSCAN_MINPOINTS=3

# ─── Congestion Candidate Filter (static baseline) ───
# Records where avg_speed < threshold AND vehicle_count > threshold are candidates.
HIGH_CONGESTION_MAX_AVG_SPEED=20
HIGH_CONGESTION_MIN_VEHICLE_COUNT=500

# ─── Geohash Cell Density Prototype (experimental, opt-in) ───
# Area-based density approximation only. Not true road-length-aware density.
DENSITY_FILTER_ENABLED=false
DENSITY_PERCENTILE_THRESHOLD=75.0

# ─── AIS Weights ───
# Must sum to 1.0. Expert-judgment defaults.
AIS_WEIGHT_VOLUME=0.30
AIS_WEIGHT_SPEED_DROP=0.30
AIS_WEIGHT_DURATION=0.25
AIS_WEIGHT_RECURRENCE=0.15

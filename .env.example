# Database used by docker-compose.yml and the FastAPI backend
DB_HOST=localhost
DB_PORT=5433
DB_NAME=istanbul_traffic
DB_USER=postgres
DB_PASSWORD=postgres

# Application
APP_ENV=development
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Offline pipeline ST_ClusterDBSCAN parameters
# Geometry is stored in EPSG:32636, so eps is in meters.
DBSCAN_EPS_METERS=500.0
DBSCAN_MINPOINTS=3

# Static congestion candidate filter used by create_views.py
HIGH_CONGESTION_MAX_AVG_SPEED=20
HIGH_CONGESTION_MIN_VEHICLE_COUNT=500

# Optional density-filter settings; the documented web workflow keeps this static.
DENSITY_FILTER_ENABLED=false
DENSITY_PERCENTILE_THRESHOLD=75.0
DENSITY_FILTER_METHOD=static
ROAD_DENSITY_PERCENTILE_THRESHOLD=75.0

# AIS weights used by the historical aggregate pipeline.
# The values must sum to 1.0.
AIS_WEIGHT_VOLUME=0.30
AIS_WEIGHT_SPEED_DROP=0.30
AIS_WEIGHT_DURATION=0.25
AIS_WEIGHT_RECURRENCE=0.15
